# Copy this file to `native/secrets.properties` (git-ignored) and fill the values.
# They are baked into the app at build time (same as the VITE_* variables of the web app).
# Every key can also be provided as an environment variable with the same name.

# Supabase project (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Vercel deployment hosting the /api/* functions (IMDb proxy, push, account deletion, watch providers)
API_BASE_URL=https://your-vercel-app-domain.com

# Third-party APIs
GOOGLE_BOOKS_API_KEY=your_google_books_api_key
TMDB_API_KEY=your_tmdb_api_key

# Native Google Sign-In: the *web* OAuth client id shared with Supabase (Google Cloud Console → Credentials)
GOOGLE_AUTH_WEB_CLIENT_ID=your_web_oauth_client_id.apps.googleusercontent.com
