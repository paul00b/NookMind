{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/s/:kind/:id",
      "destination": "/api/share?kind=:kind&id=:id"
    },
    {
      "source": "/f/:code",
      "destination": "/api/share?kind=friend&id=:code"
    },
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/api/app-links?os=android"
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/api/app-links?os=ios"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/push/send-daily",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "api/share-image.ts": {
      "includeFiles": "api/_lib/{fonts/**,logo.png}"
    }
  }
}
